
export fn vm_state_with(error, halted, handlers, ip, locals, output, stack, frames, functions):
    return {"error": error, "halted": halted, "handlers": handlers, "ip": ip, "locals": locals, "output": output, "stack": stack, "frames": frames, "functions": functions}

export fn vm_state():
    return vm_state_with(none, false, [], 0, [], [], [], [], [])

export fn vm_handlers_without_last(handlers):
    let remaining = []
    let index = 0
    while index < len(handlers):
        if index < len(handlers) - 1:
            remaining = append(remaining, handlers[index])
        index = index + 1
    return remaining

export fn vm_array_without_last(values):
    let remaining = []
    let index = 0
    while index < len(values):
        if index < len(values) - 1:
            remaining = append(remaining, values[index])
        index = index + 1
    return remaining

export fn vm_push(state, value):
    return vm_state_with(state["error"], state["halted"], state["handlers"], state["ip"], state["locals"], state["output"], append(state["stack"], value), state["frames"], state["functions"])

export fn vm_store(state, name, value):
    return vm_state_with(state["error"], state["halted"], state["handlers"], state["ip"], append(state["locals"], {"name": name, "value": value}), state["output"], state["stack"], state["frames"], state["functions"])

export fn vm_module_value_key(module_path, name):
    return "__zap_module_value::" + module_path + "::" + name

export fn vm_module_import_key(module_path):
    return "__zap_module_imports::" + module_path

export fn vm_module_scope_locals(locals, index, result):
    if index >= len(locals):
        return result
    let item = locals[index]
    if starts_with(item["name"], "__zap_module_value::") or starts_with(item["name"], "__zap_module_imports::"):
        return vm_module_scope_locals(locals, index + 1, append(result, item))
    return vm_module_scope_locals(locals, index + 1, result)

export fn vm_direct_load(state, name):
    let found = none
    for item in state["locals"]:
        if item["name"] == name:
            found = item["value"]
    if found == none:
        return {"error": "unknown_local:" + name, "value": none, "state": state}
    return {"error": none, "value": found, "state": state}

export fn vm_imported_value(state, imports, name, index):
    if index >= len(imports):
        return {"error": "unknown_local:" + name, "value": none, "state": state}
    let later = vm_imported_value(state, imports, name, index + 1)
    if later["error"] == none:
        return later
    let imported = imports[index]
    if vm_import_symbol_allowed(imported["symbols"], name, 0):
        let loaded = vm_direct_load(state, vm_module_value_key(imported["path"], name))
        if loaded["error"] == none:
            return loaded
    return later

export fn vm_module_load(state, module_path, name):
    let own = vm_direct_load(state, vm_module_value_key(module_path, name))
    if own["error"] == none:
        return own
    let local_imports = vm_direct_load(state, vm_module_import_key(module_path))
    if local_imports["error"] == none:
        return vm_imported_value(state, local_imports["value"], name, 0)
    return {"error": "unknown_local:" + name, "value": none, "state": state}

export fn vm_load(state, name):
    let direct = vm_direct_load(state, name)
    if direct["error"] == none:
        return direct
    let current_module = vm_current_module_path(state)
    if current_module != none:
        let own = vm_direct_load(state, vm_module_value_key(current_module, name))
        if own["error"] == none:
            return own
        let frame_imports = vm_current_imports(state)
        let imported = vm_imported_value(state, frame_imports, name, 0)
        if imported["error"] == none:
            return imported
    let imports = vm_direct_load(state, "__zap_imports")
    if imports["error"] == none:
        let imported = vm_imported_value(state, imports["value"], name, 0)
        if imported["error"] == none:
            return imported
    return {"error": "unknown_local:" + name, "value": none, "state": state}

export fn vm_stack_without_last(stack):
    return vm_array_without_last(stack)

export fn vm_pop(state):
    let stack = state["stack"]
    if len(stack) == 0:
        return {"error": "stack_underflow", "value": none, "state": state}
    let index = len(stack) - 1
    let next = vm_state_with(state["error"], state["halted"], state["handlers"], state["ip"], state["locals"], state["output"], vm_stack_without_last(stack), state["frames"], state["functions"])
    return {"error": none, "value": stack[index], "state": next}

export fn vm_fail(state, message):
    return vm_state_with(message, true, state["handlers"], state["ip"], state["locals"], state["output"], state["stack"], state["frames"], state["functions"])

export fn vm_reverse(values, index, result):
    if index < 0:
        return result
    return vm_reverse(values, index - 1, append(result, values[index]))

export fn vm_pop_arguments(state, remaining, values):
    if remaining == 0:
        return {"error": none, "state": state, "values": vm_reverse(values, len(values) - 1, [])}
    let popped = vm_pop(state)
    if popped["error"] != none:
        return {"error": popped["error"], "state": state, "values": []}
    return vm_pop_arguments(popped["state"], remaining - 1, append(values, popped["value"]))

export fn vm_bind_arguments(state, params, values, index):
    if index >= len(params):
        return state
    let bound = vm_store(state, params[index], values[index])
    return vm_bind_arguments(bound, params, values, index + 1)

export fn vm_capture_values(state, names, index, result):
    if index >= len(names):
        return result
    let loaded = vm_load(state, names[index])
    if loaded["error"] != none:
        return vm_capture_values(state, names, index + 1, result)
    return vm_capture_values(state, names, index + 1, append(result, {"name": names[index], "value": loaded["value"]}))

export fn vm_bind_captures(state, captures, index):
    if index >= len(captures):
        return state
    let bound = vm_store(state, captures[index]["name"], captures[index]["value"])
    return vm_bind_captures(bound, captures, index + 1)

export fn vm_local_load(locals, name, index, found):
    if index >= len(locals):
        return found
    if locals[index]["name"] == name:
        return locals[index]["value"]
    return vm_local_load(locals, name, index + 1, found)

export fn vm_symbol_allowed(symbols, name, index):
    if index >= len(symbols):
        return false
    if symbols[index] == name:
        return true
    return vm_symbol_allowed(symbols, name, index + 1)

export fn vm_sync_captures(caller_locals, closure_name, captures, callee_state, index, result):
    if index >= len(captures):
        let original = vm_local_load(caller_locals, closure_name, 0, none)
        let updated = {"captures": result, "closure": true, "function_name": original["function_name"]}
        return append(caller_locals, {"name": closure_name, "value": updated})
    let captured = captures[index]
    let loaded = vm_load(callee_state, captured["name"])
    if loaded["error"] == none:
        captured = {"name": captured["name"], "value": loaded["value"]}
    return vm_sync_captures(caller_locals, closure_name, captures, callee_state, index + 1, append(result, captured))

export fn vm_restore_closure_locals(frame, callee_state):
    if frame["closure_name"] == none:
        return frame["locals"]
    let closure = vm_local_load(frame["locals"], frame["closure_name"], 0, none)
    if closure == none:
        return frame["locals"]
    return vm_sync_captures(frame["locals"], frame["closure_name"], closure["captures"], callee_state, 0, [])

export fn vm_push_values(state, values, index):
    if index >= len(values):
        return state
    return vm_push_values(vm_push(state, values[index]), values, index + 1)

export fn vm_object_field(object, field, index):
    if index < 0:
        return {"error": "unknown_field:" + field, "value": none}
    if object["fields"][index]["name"] == field:
        return {"error": none, "value": object["fields"][index]["value"]}
    return vm_object_field(object, field, index - 1)

export fn vm_object_set_field(object, field, value, index, result):
    if index >= len(object["fields"]):
        return append(result, {"name": field, "value": value})
    if object["fields"][index]["name"] == field:
        return vm_object_set_field(object, field, value, index + 1, result)
    return vm_object_set_field(object, field, value, index + 1, append(result, object["fields"][index]))

export fn vm_find_function(functions, name, index):
    if index >= len(functions):
        return none
    let instruction = functions[index]
    let module_function = contains(json(instruction), "\"module_path\"")
    if instruction["op"] == "function_def" and instruction["name"] == name and not module_function:
        return instruction
    return vm_find_function(functions, name, index + 1)

export fn vm_find_function_in_module(functions, module_path, name, index):
    if index >= len(functions):
        return none
    let instruction = functions[index]
    if instruction["op"] == "function_def" and instruction["name"] == name and contains(json(instruction), "\"module_path\"") and instruction["module_path"] == module_path:
        return instruction
    return vm_find_function_in_module(functions, module_path, name, index + 1)

export fn vm_import_symbol_allowed(symbols, name, index):
    if index >= len(symbols):
        return false
    if symbols[index] == name:
        return true
    return vm_import_symbol_allowed(symbols, name, index + 1)

export fn vm_find_imported_function(functions, imports, name, index):
    if index >= len(imports):
        return none
    let later = vm_find_imported_function(functions, imports, name, index + 1)
    if later != none:
        return later
    let imported = imports[index]
    if vm_import_symbol_allowed(imported["symbols"], name, 0):
        let definition = vm_find_function_in_module(functions, imported["path"], name, 0)
        if definition != none:
            return definition
    return none

export fn vm_current_frame(state):
    if len(state["frames"]) == 0:
        return none
    return state["frames"][len(state["frames"]) - 1]

export fn vm_current_module_path(state):
    let frame = vm_current_frame(state)
    if frame == none:
        return none
    if contains(json(frame), "\"module_path\""):
        return frame["module_path"]
    return none

export fn vm_current_imports(state):
    let frame = vm_current_frame(state)
    if frame == none:
        return []
    if contains(json(frame), "\"imports\""):
        return frame["imports"]
    return []

export fn vm_find_class(functions, name, index):
    if index >= len(functions):
        return none
    if functions[index]["op"] == "class_def" and functions[index]["name"] == name:
        return functions[index]
    return vm_find_class(functions, name, index + 1)

export fn vm_class_field_values(functions, class_name, result):
    let class = vm_find_class(functions, class_name, 0)
    if class == none:
        return result
    let inherited = result
    if class["base"] != none:
        inherited = vm_class_field_values(functions, class["base"], inherited)
    if contains(json(class), "\"fields\""):
        for field in class["fields"]:
            inherited = append(inherited, {"name": field["name"], "value": field["value"]})
    return inherited

export fn vm_run_with_state(program, state):
    let current = state
    while current["ip"] < len(program):
        if current["halted"]:
            break
        current = vm_step(current, program[current["ip"]])
    return current

export fn vm_run_with_locals(program, functions, locals):
    return vm_run_with_state(program, vm_state_with(none, false, [], 0, locals, [], [], [], functions))

export fn vm_runtime_field_value(field, class_name, functions, locals, fields):
    if not contains(json(field), "\"default_instructions\""):
        return {"error": none, "value": field["value"]}
    let receiver = {"class_name": class_name, "fields": fields, "object": true}
    let scoped = append(locals, {"name": "self", "value": receiver})
    let program = append(field["default_instructions"], {"op": "halt"})
    let state = vm_run_with_locals(program, functions, scoped)
    if state["error"] != none:
        return {"error": state["error"], "value": none}
    if len(state["stack"]) == 0:
        return {"error": "field_default_no_value:" + field["name"], "value": none}
    return {"error": none, "value": state["stack"][len(state["stack"]) - 1]}

export fn vm_class_field_values_runtime(functions, class_name, locals, result):
    let class = vm_find_class(functions, class_name, 0)
    if class == none:
        return {"error": "unknown_class:" + class_name, "fields": result}
    let inherited = result
    if class["base"] != none:
        let parent = vm_class_field_values_runtime(functions, class["base"], locals, inherited)
        if parent["error"] != none:
            return parent
        inherited = parent["fields"]
    if contains(json(class), "\"fields\""):
        for field in class["fields"]:
            let evaluated = vm_runtime_field_value(field, class_name, functions, locals, inherited)
            if evaluated["error"] != none:
                return {"error": evaluated["error"], "fields": inherited}
            inherited = append(inherited, {"name": field["name"], "value": evaluated["value"]})
    return {"error": none, "fields": inherited}

export fn vm_find_trait(functions, name, index):
    if index >= len(functions):
        return none
    if functions[index]["op"] == "trait_def" and functions[index]["name"] == name:
        return functions[index]
    return vm_find_trait(functions, name, index + 1)

export fn vm_class_trait_names(class):
    let result = []
    if contains(json(class), "\"traits\""):
        for name in class["traits"]:
            result = append(result, name)
    if contains(json(class), "\"interfaces\""):
        for name in class["interfaces"]:
            result = append(result, name)
    return result

export fn vm_find_trait_method(functions, class, name, trait_index):
    let trait_names = vm_class_trait_names(class)
    if trait_index >= len(trait_names):
        return none
    let method = vm_find_method_direct(functions, trait_names[trait_index], name, 0)
    if method != none:
        return {"method": method, "owner": trait_names[trait_index]}
    return vm_find_trait_method(functions, class, name, trait_index + 1)

export fn vm_resolve_trait_method(functions, class, name):
    if contains(json(class), "\"trait_selections\""):
        for selection in class["trait_selections"]:
            if selection["as"] == name:
                let selected = vm_find_method_direct(functions, selection["trait"], selection["method"], 0)
                if selected == none:
                    return {"error": "unknown_trait_method:" + selection["trait"] + "." + selection["method"], "method": none, "owner": none}
                return {"error": none, "method": selected, "owner": selection["trait"]}
    let trait_names = vm_class_trait_names(class)
    let candidates = []
    for trait_name in trait_names:
        let method = vm_find_method_direct(functions, trait_name, name, 0)
        if method != none:
            candidates = append(candidates, {"method": method, "owner": trait_name})
    if len(candidates) > 1:
        return {"error": "trait_conflict:" + class["name"] + ":" + name, "method": none, "owner": none}
    if len(candidates) == 1:
        return {"error": none, "method": candidates[0]["method"], "owner": candidates[0]["owner"]}
    return {"error": none, "method": none, "owner": none}

export fn vm_resolve_method_in_mro(functions, mro, name, index):
    if index >= len(mro):
        return {"error": none, "method": none, "owner": none}
    let class_method = vm_find_method_direct(functions, mro[index], name, 0)
    if class_method != none:
        return {"error": none, "method": class_method, "owner": mro[index]}
    let class = vm_find_class(functions, mro[index], 0)
    if class != none:
        let trait_method = vm_resolve_trait_method(functions, class, name)
        if trait_method["error"] != none:
            return trait_method
        if trait_method["method"] != none:
            return trait_method
    return vm_resolve_method_in_mro(functions, mro, name, index + 1)

export fn vm_resolve_method(functions, owner, name):
    let trait = vm_find_trait(functions, owner, 0)
    if trait != none:
        let trait_method = vm_find_method_direct(functions, owner, name, 0)
        return {"error": none, "method": trait_method, "owner": owner}
    let visiting = []
    let hierarchy = vm_class_mro(functions, owner, visiting)
    if hierarchy["error"] != none:
        return {"error": hierarchy["error"], "method": none, "owner": none}
    return vm_resolve_method_in_mro(functions, hierarchy["mro"], name, 0)

export fn vm_find_method(functions, owner, name, index):
    if index > 0:
        return none
    let resolution = vm_resolve_method(functions, owner, name)
    if resolution["error"] != none:
        return none
    return resolution["method"]

export fn vm_find_parent(functions, owner):
    let class = vm_find_class(functions, owner, 0)
    if class == none:
        return none
    return class["base"]

export fn vm_contains_name(values, name, index):
    if index >= len(values):
        return false
    if values[index] == name:
        return true
    return vm_contains_name(values, name, index + 1)

export fn vm_mro_tail_has_name(sequences, name, sequence_index, item_index):
    if sequence_index >= len(sequences):
        return false
    if item_index >= len(sequences[sequence_index]):
        return vm_mro_tail_has_name(sequences, name, sequence_index + 1, 1)
    if sequences[sequence_index][item_index] == name:
        return true
    return vm_mro_tail_has_name(sequences, name, sequence_index, item_index + 1)

export fn vm_mro_pick_candidate(sequences, candidates, index):
    if index >= len(candidates):
        return none
    let candidate = candidates[index]
    if not vm_mro_tail_has_name(sequences, candidate, 0, 1):
        return candidate
    return vm_mro_pick_candidate(sequences, candidates, index + 1)

export fn vm_mro_sequence_after_head(sequence, index, result):
    if index >= len(sequence):
        return result
    return vm_mro_sequence_after_head(sequence, index + 1, append(result, sequence[index]))

export fn vm_mro_remove_head(sequences, candidate):
    let result = []
    for sequence in sequences:
        if len(sequence) == 0:
            result = append(result, sequence)
        else:
            let head = sequence[0]
            if head == candidate:
                let empty_result = []
                result = append(result, vm_mro_sequence_after_head(sequence, 1, empty_result))
            else:
                result = append(result, sequence)
    return result

export fn vm_c3_merge(sequences, result):
    let active = []
    for sequence in sequences:
        if len(sequence) > 0:
            active = append(active, sequence)
    if len(active) == 0:
        return result
    let candidates = []
    for sequence in active:
        candidates = append(candidates, sequence[0])
    let candidate = vm_mro_pick_candidate(active, candidates, 0)
    if candidate == none:
        return none
    let reduced = vm_mro_remove_head(active, candidate)
    return vm_c3_merge(reduced, append(result, candidate))

export fn vm_prepend_name(name, values):
    let result = [name]
    for value in values:
        result = append(result, value)
    return result

export fn vm_class_parents(class):
    if contains(json(class), "\"parents\""):
        return class["parents"]
    if class["base"] == none:
        return []
    return [class["base"]]

export fn vm_class_mro(functions, name, visiting):
    if vm_contains_name(visiting, name, 0):
        return {"error": "inheritance_cycle:" + name, "mro": []}
    let class = vm_find_class(functions, name, 0)
    if class == none:
        return {"error": "unknown_class:" + name, "mro": []}
    let parents = vm_class_parents(class)
    let sequences = []
    for parent in parents:
        let parent_mro = vm_class_mro(functions, parent, append(visiting, name))
        if parent_mro["error"] != none:
            return parent_mro
        sequences = append(sequences, parent_mro["mro"])
    sequences = append(sequences, parents)
    let empty_result = []
    let merged = vm_c3_merge(sequences, empty_result)
    if merged == none:
        return {"error": "inconsistent_mro:" + name, "mro": []}
    return {"error": none, "mro": vm_prepend_name(name, merged)}

export fn vm_mro_method_owner(functions, mro, name, index):
    let resolution = vm_resolve_method_in_mro(functions, mro, name, index)
    if resolution["error"] != none:
        return none
    return resolution["owner"]

export fn vm_find_mro_index(mro, owner, index):
    if index >= len(mro):
        return -1
    if mro[index] == owner:
        return index
    return vm_find_mro_index(mro, owner, index + 1)

export fn vm_find_method_direct(functions, owner, name, index):
    if index >= len(functions):
        return none
    if functions[index]["op"] == "function_def" and functions[index]["owner"] == owner and functions[index]["name"] == name:
        if not contains(json(functions[index]), "\"required\":true"):
            return functions[index]
    return vm_find_method_direct(functions, owner, name, index + 1)

export fn vm_collect_functions(program, index, result):
    if index >= len(program):
        return result
    let instruction = program[index]
    if instruction["op"] == "function_def" or instruction["op"] == "class_def" or instruction["op"] == "trait_def":
        result = append(result, instruction)
    return vm_collect_functions(program, index + 1, result)

export fn vm_raise_value(state, value):
    if len(state["handlers"]) > 0:
        let handlers = state["handlers"]
        let handler = handlers[len(handlers) - 1]
        let bound_state = vm_state_with(none, false, vm_handlers_without_last(handlers), handler["target"], state["locals"], state["output"], state["stack"], state["frames"], state["functions"])
        if handler["binding"] != none:
            bound_state = vm_store(bound_state, handler["binding"], value)
        return bound_state
    if len(state["frames"]) > 0:
        let frame = state["frames"][len(state["frames"]) - 1]
        let restored = vm_state_with(none, false, frame["handlers"], frame["return_ip"], frame["locals"], state["output"], frame["stack"], vm_array_without_last(state["frames"]), state["functions"])
        return vm_raise_value(restored, value)
    return vm_fail(state, "raised")

export fn vm_return_value(state, value):
    if len(state["frames"]) == 0:
        return vm_fail(state, "return_without_frame")
    let frame = state["frames"][len(state["frames"]) - 1]
    let restored_locals = vm_restore_closure_locals(frame, state)
    let returned_value = value
    if frame["is_constructor"] and value == none:
        returned_value = frame["constructor_instance"]
    if frame["function"] == "__init__" and len(state["frames"]) > 0:
        restored_locals = append(restored_locals, {"name": "self", "value": returned_value})
    return vm_state_with(none, false, frame["handlers"], frame["return_ip"], restored_locals, state["output"], append(frame["stack"], returned_value), vm_array_without_last(state["frames"]), state["functions"])

export fn vm_map_has_key(target, key):
    let key_json = json(key)
    let serialized = json(target)
    return contains(serialized, key_json + ":")

export fn vm_field_value(target, field):
    let serialized = json(target)
    if starts_with(serialized, "{\"class_name\":"):
        return vm_object_field(target, field, len(target["fields"]) - 1)
    if not starts_with(serialized, "{"):
        return {"error": "unknown_field:" + field, "value": none}
    if not vm_map_has_key(target, field):
        return {"error": "unknown_field:" + field, "value": none}
    return {"error": none, "value": target[field]}

export fn vm_list_set(values, index, value, cursor, result):
    if cursor >= len(values):
        return result
    if cursor == index:
        return vm_list_set(values, index, value, cursor + 1, append(result, value))
    return vm_list_set(values, index, value, cursor + 1, append(result, values[cursor]))

export fn vm_structural_map_set(target, key, value):
    let serialized = json(target)
    if not starts_with(serialized, "{"):
        return {"error": "map_set_requires_map", "value": none}
    if not starts_with(json(key), "\""):
        return {"error": "map_index_requires_text", "value": none}
    return {"error": none, "value": map_set(target, key, value)}

export fn vm_index_store_value(target, key, value):
    let serialized = json(target)
    if starts_with(serialized, "["):
        if starts_with(json(key), "\""):
            return {"error": "list_index_requires_number", "value": none}
        if key < 0 or key >= len(target):
            return {"error": "list_index_out_of_bounds", "value": none}
        return {"error": none, "value": vm_list_set(target, key, value, 0, [])}
    if starts_with(serialized, "{"):
        return vm_structural_map_set(target, key, value)
    return {"error": "value_not_indexable", "value": none}

export fn vm_iter_length(target):
    let serialized = json(target)
    if starts_with(serialized, "[") or starts_with(serialized, "\""):
        return {"error": none, "value": len(target)}
    if starts_with(serialized, "{"):
        return {"error": none, "value": len(entries(target))}
    return {"error": "for expects a list, map, or text", "value": none}

export fn vm_iter_get(target, index):
    let serialized = json(target)
    if starts_with(serialized, "["):
        return vm_index_value(target, index)
    if starts_with(serialized, "{"):
        let map_entries = entries(target)
        let entry = vm_index_value(map_entries, index)
        if entry["error"] != none:
            return entry
        return {"error": none, "value": entry["value"]["key"]}
    if starts_with(serialized, "\""):
        if index < 0 or index >= len(target):
            return {"error": "iter_index_out_of_bounds", "value": none}
        return {"error": none, "value": substring(target, index, index + 1)}
    return {"error": "for expects a list, map, or text", "value": none}

export fn vm_index_value(target, key):
    let serialized = json(target)
    if starts_with(serialized, "["):
        if starts_with(json(key), "\""):
            return {"error": "list_index_requires_number", "value": none}
        if key < 0:
            return {"error": "list_index_out_of_bounds", "value": none}
        if key >= len(target):
            return {"error": "list_index_out_of_bounds", "value": none}
        return {"error": none, "value": target[key]}
    if starts_with(serialized, "{"):
        if not starts_with(json(key), "\""):
            return {"error": "map_index_requires_text", "value": none}
        if not vm_map_has_key(target, key):
            return {"error": "map_key_not_found", "value": none}
        return {"error": none, "value": target[key]}
    return {"error": "value_not_indexable", "value": none}

export fn vm_step(state, instruction):
    let op = instruction["op"]
    let advanced = vm_state_with(state["error"], state["halted"], state["handlers"], state["ip"] + 1, state["locals"], state["output"], state["stack"], state["frames"], state["functions"])
    if op == "module_alias":
        let symbols = []
        let module_path = none
        if contains(json(instruction), "\"symbols\""):
            symbols = instruction["symbols"]
        if contains(json(instruction), "\"module_path\""):
            module_path = instruction["module_path"]
        return vm_store(advanced, instruction["name"], {"alias": instruction["name"], "module_alias": true, "module_path": module_path, "symbols": symbols})
    if op == "module_import_local":
        let current = vm_direct_load(advanced, vm_module_import_key(instruction["module_path"]))
        let imports = []
        if current["error"] == none:
            imports = current["value"]
        return vm_store(advanced, vm_module_import_key(instruction["module_path"]), append(imports, {"path": instruction["imported_path"], "symbols": instruction["symbols"]}))
    if op == "module_store":
        let stored = vm_pop(advanced)
        if stored["error"] != none:
            return vm_fail(advanced, stored["error"])
        return vm_store(stored["state"], vm_module_value_key(instruction["module_path"], instruction["name"]), stored["value"])
    if op == "module_import":
        let symbols = []
        if contains(json(instruction), "\"symbols\""):
            symbols = instruction["symbols"]
        let current = vm_load(advanced, "__zap_imports")
        let imports = []
        if current["error"] == none:
            imports = current["value"]
        return vm_store(advanced, "__zap_imports", append(imports, {"path": instruction["module_path"], "symbols": symbols}))
    if op == "function_def":
        let registered = advanced
        if instruction["binding"] != none:
            let captured = vm_capture_values(advanced, instruction["captures"], 0, [])
            let closure = {"captures": captured, "closure": true, "function_name": instruction["name"]}
            registered = vm_store(advanced, instruction["binding"], closure)
        return vm_state_with(none, false, registered["handlers"], instruction["end"], registered["locals"], registered["output"], registered["stack"], registered["frames"], registered["functions"])
    if op == "class_def" or op == "trait_def":
        return vm_state_with(none, false, advanced["handlers"], instruction["end"], advanced["locals"], advanced["output"], advanced["stack"], advanced["frames"], advanced["functions"])
    if op == "jump":
        return vm_state_with(none, false, advanced["handlers"], instruction["target"], advanced["locals"], advanced["output"], advanced["stack"], advanced["frames"], advanced["functions"])
    if op == "jump_if_true":
        let condition = vm_pop(advanced)
        if condition["error"] != none:
            return vm_fail(advanced, condition["error"])
        if condition["value"]:
            return vm_state_with(none, false, condition["state"]["handlers"], instruction["target"], condition["state"]["locals"], condition["state"]["output"], condition["state"]["stack"], condition["state"]["frames"], condition["state"]["functions"])
        return condition["state"]
    if op == "jump_if_false":
        let condition = vm_pop(advanced)
        if condition["error"] != none:
            return vm_fail(advanced, condition["error"])
        if not condition["value"]:
            return vm_state_with(none, false, condition["state"]["handlers"], instruction["target"], condition["state"]["locals"], condition["state"]["output"], condition["state"]["stack"], condition["state"]["frames"], condition["state"]["functions"])
        return condition["state"]
    if op == "try_begin":
        let handler = {"binding": instruction["binding"], "target": instruction["target"]}
        return vm_state_with(none, false, append(advanced["handlers"], handler), advanced["ip"], advanced["locals"], advanced["output"], advanced["stack"], advanced["frames"], advanced["functions"])
    if op == "try_end":
        return vm_state_with(none, false, vm_handlers_without_last(advanced["handlers"]), advanced["ip"], advanced["locals"], advanced["output"], advanced["stack"], advanced["frames"], advanced["functions"])
    if op == "raise":
        let raised = vm_pop(advanced)
        if raised["error"] != none:
            return vm_fail(advanced, raised["error"])
        return vm_raise_value(raised["state"], raised["value"])
    if op == "return_value":
        let returned = vm_pop(advanced)
        if returned["error"] != none:
            return vm_fail(advanced, returned["error"])
        return vm_return_value(returned["state"], returned["value"])
    if op == "return_none":
        return vm_return_value(advanced, none)
    if op == "dup":
        let top = vm_pop(advanced)
        if top["error"] != none:
            return vm_fail(advanced, top["error"])
        let restored = vm_push(top["state"], top["value"])
        return vm_push(restored, top["value"])
    if op == "pop":
        let discarded = vm_pop(advanced)
        if discarded["error"] != none:
            return vm_fail(advanced, discarded["error"])
        return discarded["state"]
    if op == "load":
        let loaded = vm_load(advanced, instruction["name"])
        if loaded["error"] != none:
            return vm_fail(advanced, loaded["error"])
        return vm_push(loaded["state"], loaded["value"])
    if op == "module_load":
        let loaded = vm_module_load(advanced, instruction["module_path"], instruction["name"])
        if loaded["error"] != none:
            return vm_fail(advanced, loaded["error"])
        return vm_push(loaded["state"], loaded["value"])
    if op == "store":
        let stored = vm_pop(advanced)
        if stored["error"] != none:
            return vm_fail(advanced, stored["error"])
        return vm_store(stored["state"], instruction["name"], stored["value"])
    if op == "field_load":
        let receiver = vm_load(advanced, instruction["receiver"])
        if receiver["error"] != none:
            return vm_fail(advanced, receiver["error"])
        let receiver_json = json(receiver["value"])
        if contains(receiver_json, "\"module_alias\":true"):
            if not vm_import_symbol_allowed(receiver["value"]["symbols"], instruction["field"], 0):
                return vm_fail(advanced, "module_symbol_not_exported:" + instruction["field"])
            let module_value = vm_direct_load(advanced, vm_module_value_key(receiver["value"]["module_path"], instruction["field"]))
            if module_value["error"] != none:
                return vm_fail(advanced, module_value["error"])
            return vm_push(module_value["state"], module_value["value"])
        let field = vm_field_value(receiver["value"], instruction["field"])
        if field["error"] != none:
            return vm_fail(advanced, field["error"])
        return vm_push(advanced, field["value"])
    if op == "iter_length":
        let iterable = vm_pop(advanced)
        if iterable["error"] != none:
            return vm_fail(advanced, iterable["error"])
        let length = vm_iter_length(iterable["value"])
        if length["error"] != none:
            return vm_fail(iterable["state"], length["error"])
        return vm_push(iterable["state"], length["value"])
    if op == "iter_get":
        let popped_index = vm_pop(advanced)
        if popped_index["error"] != none:
            return vm_fail(advanced, popped_index["error"])
        let popped_target = vm_pop(popped_index["state"])
        if popped_target["error"] != none:
            return vm_fail(popped_index["state"], popped_target["error"])
        let item = vm_iter_get(popped_target["value"], popped_index["value"])
        if item["error"] != none:
            return vm_fail(popped_target["state"], item["error"])
        return vm_push(popped_target["state"], item["value"])
    if op == "member_load":
        let popped_key = vm_pop(advanced)
        if popped_key["error"] != none:
            return vm_fail(advanced, popped_key["error"])
        let popped_target = vm_pop(popped_key["state"])
        if popped_target["error"] != none:
            return vm_fail(popped_key["state"], popped_target["error"])
        let member = vm_field_value(popped_target["value"], popped_key["value"])
        if member["error"] != none:
            return vm_fail(popped_target["state"], member["error"])
        return vm_push(popped_target["state"], member["value"])
    if op == "index":
        let popped_key = vm_pop(advanced)
        if popped_key["error"] != none:
            return vm_fail(advanced, popped_key["error"])
        let popped_target = vm_pop(popped_key["state"])
        if popped_target["error"] != none:
            return vm_fail(advanced, popped_target["error"])
        let indexed = vm_index_value(popped_target["value"], popped_key["value"])
        if indexed["error"] != none:
            return vm_fail(popped_target["state"], indexed["error"])
        return vm_push(popped_target["state"], indexed["value"])
    if op == "index_store":
        let stored = vm_pop(advanced)
        if stored["error"] != none:
            return vm_fail(advanced, stored["error"])
        let popped_key = vm_pop(stored["state"])
        if popped_key["error"] != none:
            return vm_fail(stored["state"], popped_key["error"])
        let popped_target = vm_pop(popped_key["state"])
        if popped_target["error"] != none:
            return vm_fail(popped_key["state"], popped_target["error"])
        let updated = vm_index_store_value(popped_target["value"], popped_key["value"], stored["value"])
        if updated["error"] != none:
            return vm_fail(popped_target["state"], updated["error"])
        return vm_store(popped_target["state"], instruction["receiver"], updated["value"])
    if op == "field_store":
        let stored = vm_pop(advanced)
        if stored["error"] != none:
            return vm_fail(advanced, stored["error"])
        let receiver = vm_load(stored["state"], instruction["receiver"])
        if receiver["error"] != none:
            return vm_fail(stored["state"], receiver["error"])
        let receiver_value = receiver["value"]
        let serialized_receiver = json(receiver_value)
        if starts_with(serialized_receiver, "{") and not starts_with(serialized_receiver, "{\"class_name\":"):
            let updated_map = vm_index_store_value(receiver_value, instruction["field"], stored["value"])
            if updated_map["error"] != none:
                return vm_fail(stored["state"], updated_map["error"])
            return vm_store(stored["state"], instruction["receiver"], updated_map["value"])
        let updated = {"class_name": receiver_value["class_name"], "fields": vm_object_set_field(receiver_value, instruction["field"], stored["value"], 0, []), "object": true}
        return vm_store(stored["state"], instruction["receiver"], updated)
    if op == "const":
        return vm_push(advanced, instruction["value"])
    if op == "not":
        let operand = vm_pop(advanced)
        if operand["error"] != none:
            return vm_fail(advanced, operand["error"])
        return vm_push(operand["state"], not operand["value"])
    if op == "await":
        let awaited = vm_pop(advanced)
        if awaited["error"] != none:
            return vm_fail(advanced, awaited["error"])
        return vm_push(awaited["state"], awaited["value"])
    if op == "propagate":
        let propagated = vm_pop(advanced)
        if propagated["error"] != none:
            return vm_fail(advanced, propagated["error"])
        let value = propagated["value"]
        let serialized = json(value)
        if starts_with(serialized, "{") and vm_map_has_key(value, "ok"):
            if value["ok"] == true and vm_map_has_key(value, "value"):
                return vm_push(propagated["state"], value["value"])
            if vm_map_has_key(value, "error") and value["error"] != none:
                return vm_raise_value(propagated["state"], value["error"])
        return vm_fail(propagated["state"], "propagate_requires_result_or_option")
    if op == "super_call":
        if len(state["frames"]) == 0:
            return vm_fail(advanced, "super_outside_method")
        let current_frame = state["frames"][len(state["frames"]) - 1]
        if current_frame["owner"] == none:
            return vm_fail(advanced, "super_outside_class")
        let super_arguments = vm_pop_arguments(advanced, instruction["argc"], [])
        if super_arguments["error"] != none:
            return vm_fail(advanced, super_arguments["error"])
        let receiver = vm_load(super_arguments["state"], "self")
        if receiver["error"] != none:
            return vm_fail(advanced, receiver["error"])
        let visiting = []
        let resolution = vm_class_mro(advanced["functions"], receiver["value"]["class_name"], visiting)
        if resolution["error"] != none:
            return vm_fail(advanced, resolution["error"])
        let current_index = vm_find_mro_index(resolution["mro"], current_frame["owner"], 0)
        if current_index < 0:
            return vm_fail(advanced, "super_owner_not_in_mro:" + current_frame["owner"])
        if current_index + 1 >= len(resolution["mro"]):
            return vm_fail(advanced, "super_no_parent:" + current_frame["owner"])
        let next_method = vm_resolve_method_in_mro(advanced["functions"], resolution["mro"], instruction["method"], current_index + 1)
        if next_method["error"] != none:
            return vm_fail(advanced, next_method["error"])
        let parent = next_method["owner"]
        if parent == none:
            return vm_fail(advanced, "unknown_super_method:" + instruction["method"])
        let receiver_state = vm_state_with(none, false, super_arguments["state"]["handlers"], advanced["ip"] - 1, super_arguments["state"]["locals"], super_arguments["state"]["output"], super_arguments["state"]["stack"], super_arguments["state"]["frames"], super_arguments["state"]["functions"])
        let with_receiver = vm_push_values(vm_push(receiver_state, receiver["value"]), super_arguments["values"], 0)
        return vm_step(with_receiver, {"argc": instruction["argc"] + 1, "name": instruction["method"], "op": "call", "owner": parent})
    if op == "method_call":
        let method_arguments = vm_pop_arguments(advanced, instruction["argc"], [])
        if method_arguments["error"] != none:
            return vm_fail(advanced, method_arguments["error"])
        let receiver = vm_load(method_arguments["state"], instruction["receiver"])
        if receiver["error"] != none:
            return vm_fail(advanced, receiver["error"])
        let receiver_json = json(receiver["value"])
        if contains(receiver_json, "\"module_alias\":true"):
            if contains(receiver_json, "\"symbols\"") and not vm_symbol_allowed(receiver["value"]["symbols"], instruction["method"], 0):
                return vm_fail(advanced, "module_symbol_not_exported:" + instruction["method"])
            let alias_base = vm_state_with(none, false, method_arguments["state"]["handlers"], advanced["ip"] - 1, method_arguments["state"]["locals"], method_arguments["state"]["output"], method_arguments["state"]["stack"], method_arguments["state"]["frames"], method_arguments["state"]["functions"])
            let alias_state = vm_push_values(alias_base, method_arguments["values"], 0)
            return vm_step(alias_state, {"argc": instruction["argc"], "module_path": receiver["value"]["module_path"], "name": instruction["method"], "op": "call"})
        let receiver_state = vm_state_with(none, false, method_arguments["state"]["handlers"], advanced["ip"] - 1, method_arguments["state"]["locals"], method_arguments["state"]["output"], method_arguments["state"]["stack"], method_arguments["state"]["frames"], method_arguments["state"]["functions"])
        let with_receiver = vm_push_values(vm_push(receiver_state, receiver["value"]), method_arguments["values"], 0)
        return vm_step(with_receiver, {"argc": instruction["argc"] + 1, "name": instruction["method"], "op": "call", "owner": receiver["value"]["class_name"]})
    if op == "call":
        let arguments = vm_pop_arguments(advanced, instruction["argc"], [])
        if arguments["error"] != none:
            return vm_fail(advanced, arguments["error"])
        let name = instruction["name"]
        if name == "identity" and instruction["argc"] == 1:
            return vm_push(arguments["state"], arguments["values"][0])
        if name == "abs" and instruction["argc"] == 1:
            let value = arguments["values"][0]
            if value < 0:
                value = 0 - value
            return vm_push(arguments["state"], value)
        if name == "map_set" and instruction["argc"] == 3:
            let updated = vm_structural_map_set(arguments["values"][0], arguments["values"][1], arguments["values"][2])
            if updated["error"] != none:
                return vm_fail(arguments["state"], updated["error"])
            return vm_push(arguments["state"], updated["value"])
        let definition_name = name
        let captures = []
        let owner = none
        let constructor = false
        let constructor_instance = none
        let instruction_json = json(instruction)
        if contains(instruction_json, "\"owner\""):
            owner = instruction["owner"]
        if contains(instruction_json, "\"constructor\":true"):
            constructor = true
            constructor_instance = instruction["instance"]
        if owner != none:
            let owner_trait = vm_find_trait(advanced["functions"], owner, 0)
            if owner_trait == none:
                let visiting = []
                let hierarchy = vm_class_mro(advanced["functions"], owner, visiting)
                if hierarchy["error"] != none:
                    return vm_fail(advanced, hierarchy["error"])
        let loaded = vm_load(arguments["state"], name)
        if loaded["error"] == none:
            let serialized = json(loaded["value"])
            if contains(serialized, "\"closure\":true"):
                definition_name = loaded["value"]["function_name"]
                captures = loaded["value"]["captures"]
        let definition = none
        let requested_module = none
        if contains(instruction_json, "\"module_path\""):
            requested_module = instruction["module_path"]
        if owner != none:
            let method_resolution = vm_resolve_method(advanced["functions"], owner, definition_name)
            if method_resolution["error"] != none:
                return vm_fail(advanced, method_resolution["error"])
            definition = method_resolution["method"]
        else:
            if requested_module != none:
                definition = vm_find_function_in_module(advanced["functions"], requested_module, definition_name, 0)
                if definition == none:
                    return vm_fail(advanced, "module_lookup_failed:" + requested_module + ":" + definition_name)
            else:
                let current_module = vm_current_module_path(arguments["state"])
                if current_module != none:
                    definition = vm_find_function_in_module(advanced["functions"], current_module, definition_name, 0)
                    if definition == none:
                        definition = vm_find_imported_function(advanced["functions"], vm_current_imports(arguments["state"]), definition_name, 0)
                else:
                    let imported = vm_load(arguments["state"], "__zap_imports")
                    let imported_records = []
                    if imported["error"] == none:
                        imported_records = imported["value"]
                    definition = vm_find_imported_function(advanced["functions"], imported_records, definition_name, 0)
                    if definition == none:
                        definition = vm_find_function(advanced["functions"], definition_name, 0)
        if definition == none:
            let class = vm_find_class(advanced["functions"], definition_name, 0)
            if class != none:
                let visiting = []
                let hierarchy = vm_class_mro(advanced["functions"], definition_name, visiting)
                if hierarchy["error"] != none:
                    return vm_fail(advanced, hierarchy["error"])
                let constructor_resolution = vm_resolve_method(advanced["functions"], definition_name, "__init__")
                if constructor_resolution["error"] != none:
                    return vm_fail(advanced, constructor_resolution["error"])
                let constructor_definition = constructor_resolution["method"]
                let field_result = vm_class_field_values_runtime(advanced["functions"], definition_name, arguments["state"]["locals"], [])
                if field_result["error"] != none:
                    return vm_fail(advanced, field_result["error"])
                if constructor_definition == none:
                    if instruction["argc"] == 0:
                        return vm_push(arguments["state"], {"class_name": definition_name, "fields": field_result["fields"], "object": true})
                    return vm_fail(advanced, "arity_error:" + name)
                let instance = {"class_name": definition_name, "fields": field_result["fields"], "object": true}
                let constructor_state = vm_state_with(none, false, arguments["state"]["handlers"], advanced["ip"] - 1, arguments["state"]["locals"], arguments["state"]["output"], arguments["state"]["stack"], arguments["state"]["frames"], arguments["state"]["functions"])
                let with_instance = vm_push_values(vm_push(constructor_state, instance), arguments["values"], 0)
                return vm_step(with_instance, {"argc": instruction["argc"] + 1, "name": "__init__", "op": "call", "owner": definition_name, "constructor": true, "instance": instance})
            return vm_fail(advanced, "unknown_call:" + name)
        if len(definition["params"]) != instruction["argc"]:
            return vm_fail(advanced, "arity_error:" + name)
        let closure_name = none
        let capture_names = []
        if len(captures) > 0:
            closure_name = name
            for captured in captures:
                capture_names = append(capture_names, captured)
        let frame_owner = owner
        if owner != none:
            frame_owner = definition["owner"]
        let frame_module = none
        let frame_imports = []
        if contains(json(definition), "\"module_path\""):
            frame_module = definition["module_path"]
        if contains(json(definition), "\"imports\""):
            frame_imports = definition["imports"]
        let frame = {"capture_names": capture_names, "closure_name": closure_name, "constructor_instance": constructor_instance, "function": definition_name, "handlers": arguments["state"]["handlers"], "imports": frame_imports, "is_constructor": constructor, "locals": arguments["state"]["locals"], "module_path": frame_module, "owner": frame_owner, "return_ip": arguments["state"]["ip"], "stack": arguments["state"]["stack"]}
        let callee_locals = []
        if frame_module != none:
            callee_locals = vm_module_scope_locals(arguments["state"]["locals"], 0, [])
        let callee = vm_state_with(none, false, [], definition["entry"], callee_locals, arguments["state"]["output"], [], append(arguments["state"]["frames"], frame), arguments["state"]["functions"])
        let with_captures = vm_bind_captures(callee, captures, 0)
        return vm_bind_arguments(with_captures, definition["params"], arguments["values"], 0)
    if op == "add" or op == "subtract" or op == "multiply" or op == "divide" or op == "remainder" or op == "equal" or op == "not_equal" or op == "less" or op == "less_equal" or op == "greater" or op == "greater_equal" or op == "and" or op == "or":
        let right = vm_pop(advanced)
        if right["error"] != none:
            return vm_fail(advanced, right["error"])
        let left = vm_pop(right["state"])
        if left["error"] != none:
            return vm_fail(advanced, left["error"])
        let value = none
        if op == "add":
            value = left["value"] + right["value"]
        if op == "subtract":
            value = left["value"] - right["value"]
        if op == "multiply":
            value = left["value"] * right["value"]
        if op == "divide":
            value = left["value"] / right["value"]
        if op == "remainder":
            value = left["value"] % right["value"]
        if op == "equal":
            value = left["value"] == right["value"]
        if op == "not_equal":
            value = left["value"] != right["value"]
        if op == "less":
            value = left["value"] < right["value"]
        if op == "less_equal":
            value = left["value"] <= right["value"]
        if op == "greater":
            value = left["value"] > right["value"]
        if op == "greater_equal":
            value = left["value"] >= right["value"]
        if op == "and":
            value = left["value"] and right["value"]
        if op == "or":
            value = left["value"] or right["value"]
        return vm_push(left["state"], value)
    if op == "print":
        let item = vm_pop(advanced)
        if item["error"] != none:
            return vm_fail(advanced, item["error"])
        return vm_state_with(none, false, item["state"]["handlers"], item["state"]["ip"], item["state"]["locals"], append(item["state"]["output"], item["value"]), item["state"]["stack"], item["state"]["frames"], item["state"]["functions"])
    if op == "halt":
        return vm_state_with(none, true, advanced["handlers"], advanced["ip"], advanced["locals"], advanced["output"], advanced["stack"], advanced["frames"], advanced["functions"])
    return vm_fail(advanced, "unknown_opcode:" + op)

export fn vm_run(program):
    let functions = vm_collect_functions(program, 0, [])
    return vm_run_with_locals(program, functions, [])
